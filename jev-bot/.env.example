# Copy to .env and fill in. .env is git-ignored. Never paste keys into code, chat, or logs.
TYPESAFE_API_KEY=            # Jev (console.typesafe.ai)
ANTHROPIC_API_KEY=           # Opus 5.5 nightly brain (or use `ant auth login`)
ALPACA_API_KEY=              # Alpaca PAPER keys. Trade permission only; withdrawals don't exist on Alpaca API keys
ALPACA_SECRET_KEY=
TELEGRAM_BOT_TOKEN=          # from @BotFather
TELEGRAM_CHAT_ID=

# Trading universe
SYMBOL=BTC/USD
TIMEFRAME_MIN=15

# HARD LIMITS (code-enforced; no model can change these)
MAX_POSITION_USD=1000
DAILY_LOSS_LIMIT_USD=100
MAX_DRAWDOWN_PCT=10
MANUAL_APPROVAL_ABOVE_USD=500
KELLY_CAP=0.25

# Live trading stays OFF until scripts/go_live_check passes AND you flip this yourself.
LIVE_TRADING=0
